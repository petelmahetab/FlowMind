// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  pro
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  plan      Plan     @default(free)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sops Sop[]

  @@index([clerkId])

  assignedToMe  SopAssignment[] @relation("AssignedTo")
  assignedByMe  SopAssignment[] @relation("AssignedBy")
}

model Sop {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  rawText     String  @db.Text
  shareSlug   String  @unique
  isPublic    Boolean @default(false)

  // due date — needed so an ExecutionRun can be flagged overdue
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps         Step[]
  executionRuns ExecutionRun[]
  assignments   SopAssignment[]

  @@index([userId])
  @@index([shareSlug])
}

model Step {
  id          String  @id @default(cuid())
  sopId       String
  sop         Sop     @relation(fields: [sopId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  owner       String?
  durationMins Int?
  order       Int

  checklistItems ChecklistItem[]

  @@index([sopId])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  stepId String
  step   Step    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  text  String
  done  Boolean @default(false)
  order Int

  stepLogs ExecutionStepLog[]

  @@index([stepId])
}

// ─── Execution Tracking ───
// One ExecutionRun = one person actually doing a SOP, start to finish.
// This is what's missing in every SOP tool: proof someone followed it,
// not just that someone wrote it.

enum RunStatus {
  in_progress
  completed
  overdue
}

model ExecutionRun {
  id    String @id @default(cuid())
  sopId String
  sop   Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)

  // Who is executing — identified by email since they may not have an account
  // (this also works for the public share-link flow, no login required)
  executorEmail String
  executorName  String?

  status      RunStatus @default(in_progress)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // denormalized progress counters — avoids recomputing on every dashboard read
  totalItems     Int @default(0)
  completedItems Int @default(0)

  stepLogs ExecutionStepLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sopId])
  @@index([executorEmail])
  @@index([status])
}

// One row per checklist-item tick/untick — this is the audit trail.
// "Who checked off step 4 at 2:14pm" is exactly what compliance reviews ask for.
model ExecutionStepLog {
  id    String       @id @default(cuid())
  runId String
  run   ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  done       Boolean  @default(true)
  toggledAt  DateTime @default(now())

  @@index([runId])
  @@index([checklistItemId])
}

model SopAssignment {
  id           String    @id @default(cuid())
  sopId        String
  sop          Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User      @relation("AssignedTo", fields: [assignedToId], references: [id])

  assignedById String
  assignedBy   User      @relation("AssignedBy", fields: [assignedById], references: [id])

  status       String    @default("pending")
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@index([assignedToId])
  @@index([sopId])
}