// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  pro
}


enum AssignmentStatus {
  pending
  in_progress
  completed
  overdue
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  plan      Plan     @default(free)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sops             Sop[]
  stepCompletions  StepCompletion[]
  assignmentsGiven    SopAssignment[] @relation("AssignedBy")   
  assignmentsReceived SopAssignment[] @relation("AssignedTo")   

  @@index([clerkId])
}

model Sop {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  rawText     String  @db.Text
  shareSlug   String  @unique
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps            Step[]
  stepCompletions  StepCompletion[]
  versions         SopVersion[]      
  assignments      SopAssignment[]   

  @@index([userId])
  @@index([shareSlug])
}

model Step {
  id          String  @id @default(cuid())
  sopId       String
  sop         Sop     @relation(fields: [sopId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  owner       String?
  durationMins Int?
  order       Int

  checklistItems  ChecklistItem[]
  stepCompletions StepCompletion[]

  @@index([sopId])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  stepId String
  step   Step    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  text  String
  done  Boolean @default(false)
  order Int

  @@index([stepId])
}

model StepCompletion {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  sopId     String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sop  Sop  @relation(fields: [sopId],  references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId, sopId])
}


model SopVersion {
  id        String   @id @default(cuid())
  sopId     String
  sop       Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)

  versionNumber Int
  title         String
  description   String?
  stepsSnapshot Json      
  changeSummary String?   
  editedBy      String?  

  createdAt DateTime @default(now())

  @@index([sopId])
  @@unique([sopId, versionNumber])
}

model SopAssignment {
  id     String @id @default(cuid())
  sopId  String
  sop    Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)

  status   AssignmentStatus @default(pending)
  dueDate  DateTime?
  notifiedOverdue Boolean @default(false)  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sopId])
  @@index([assignedToId])
  @@index([assignedById])
  @@unique([sopId, assignedToId])  
}