generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  clerkId      String          @unique
  email        String          @unique
  name         String?
  imageUrl     String?
  plan         Plan            @default(free)
  stripeCustomerId     String?   @unique   
  stripeSubscriptionId String?   @unique 
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sops         Sop[]
  assignedByMe SopAssignment[] @relation("AssignedBy")
  assignedToMe SopAssignment[] @relation("AssignedTo")
  webhooks     Webhook[]       

  @@index([clerkId])
}

model Sop {
  id            String          @id @default(cuid())
  userId        String
  title         String
  description   String?
  rawText       String
  shareSlug     String          @unique
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dueDate       DateTime?
  executionRuns ExecutionRun[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   SopAssignment[]
  steps         Step[]

  @@index([userId])
  @@index([shareSlug])
}

model Step {
  id             String          @id @default(cuid())
  sopId          String
  title          String
  description    String?
  owner          String?
  durationMins   Int?
  order          Int
  branches       Json?
  checklistItems ChecklistItem[]
  sop            Sop             @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

model ChecklistItem {
  id       String             @id @default(cuid())
  stepId   String
  text     String
  done     Boolean            @default(false)
  order    Int
  step     Step               @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepLogs ExecutionStepLog[]

  @@index([stepId])
}

model ExecutionRun {
  id             String             @id @default(cuid())
  sopId          String
  executorEmail  String
  executorName   String?
  status         RunStatus          @default(in_progress)
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  totalItems     Int                @default(0)
  completedItems Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sop            Sop                @relation(fields: [sopId], references: [id], onDelete: Cascade)
  stepLogs       ExecutionStepLog[]

  @@index([sopId])
  @@index([executorEmail])
  @@index([status])
}

model ExecutionStepLog {
  id              String        @id @default(cuid())
  runId           String
  checklistItemId String
  done            Boolean       @default(true)
  toggledAt       DateTime      @default(now())
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  run             ExecutionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([checklistItemId])
}

model SopAssignment {
  id           String    @id @default(cuid())
  sopId        String
  assignedById String
  assignedToId String
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  status       String    @default("pending")
  assignedBy   User      @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo   User      @relation("AssignedTo", fields: [assignedToId], references: [id])
  sop          Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([sopId])
}

// 👇 Feature 2 — Webhook System
model Webhook {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String           // HMAC signing key
  events    String[]         // ["sop.completed", "sop.started", "run.completed"]
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String   // "sop.completed"
  payload      Json
  statusCode   Int?
  success      Boolean  @default(false)
  attempts     Int      @default(0)
  lastAttemptAt DateTime?
  createdAt    DateTime @default(now())

  @@index([webhookId])
}

enum Plan {
  free
  pro
}

enum RunStatus {
  in_progress
  completed
  overdue
}